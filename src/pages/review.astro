---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SignalBadge from '../components/SignalBadge.astro';
import { industryShort } from '../lib/industries';
import { computeScore } from '../lib/score';
import { readDraftStates } from '../../scripts/lib/repo-frontmatter.mjs';

const numberFmt = new Intl.NumberFormat('vi-VN');

/** Ngày kể từ lần push cuối — tín hiệu repo còn sống hay đã bỏ. */
function daysSince(value: Date | undefined): number | null {
  if (!value) return null;
  const days = Math.floor((Date.now() - value.getTime()) / 86_400_000);
  return Number.isFinite(days) ? days : null;
}

/** Mốc push cuối, dạng text thường — để so sánh nhanh giữa các record. */
function pushedLabel(days: number | null): string | null {
  if (days == null) return null;
  if (days < 1) return 'push hôm nay';
  if (days < 30) return `push ${days} ngày trước`;
  if (days < 365) return `push ${Math.floor(days / 30)} tháng trước`;
  return `push ${Math.floor(days / 365)} năm trước`;
}

/**
 * Chỉ cảnh báo khi repo thực sự có dấu hiệu bị bỏ. Ngưỡng 30 ngày từng làm
 * 76/128 record hiện badge — báo động ở khắp nơi thì không còn là tín hiệu.
 */
function isAbandoned(days: number | null): boolean {
  return days != null && days >= 365;
}

const canEdit = import.meta.env.DEV;

// Prod cũng liệt kê draft — trang này nằm sau gate member ở functions/_middleware.js.
const draftStates = canEdit ? await readDraftStates() : new Map<string, boolean>();
const entries = (await getCollection('repos')).sort((a, b) => {
  const aDraft = draftStates.get(a.id) ?? a.data.draft;
  const bDraft = draftStates.get(b.id) ?? b.data.draft;
  if (aDraft !== bDraft) return aDraft ? -1 : 1;
  return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
});

const drafts = entries.filter((entry) => draftStates.get(entry.id) ?? entry.data.draft).length;
const published = entries.length - drafts;
const deployOnPublish = canEdit && process.env.REPO_RADAR_AUTO_DEPLOY === 'true';
const deployHint = !canEdit
  ? ' Publish/Về draft sẽ commit lên GitHub; site cập nhật sau khi Cloudflare build xong.'
  : deployOnPublish
    ? ' Publish/Về draft sẽ build production và deploy sau bước xác nhận.'
    : ' Publish/Về draft chỉ ghi file local.';
---

<BaseLayout title="Duyệt draft | AltStack" description="Màn hình duyệt draft local cho AltStack">
  <header class="mb-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <a href="/" class="text-sm text-[var(--rr-muted)] no-underline hover:text-[var(--rr-text)]">Trang chủ</a>
        <h1 class="mt-2 text-2xl font-bold tracking-tight">Duyệt draft</h1>
      </div>
      <p class="rounded-md border border-[var(--rr-border)] bg-[var(--rr-surface)] px-3 py-2 text-xs text-[var(--rr-muted)]">
        {drafts} draft / {published} published
      </p>
    </div>
    <p class="mt-2 max-w-prose text-sm text-[var(--rr-muted)]">
      Mở bài để đọc và soát trạng thái.
      {deployOnPublish && ' Auto-deploy production đang bật.'}
      {deployHint}
    </p>
  </header>

  <section class="space-y-3">
      {entries.map((entry) => {
        const r = entry.data;
        const isDraft = draftStates.get(entry.id) ?? r.draft;
        const { total, hasScore } = computeScore(r);
        const stats = r.repoStats;
        const pushedDays = daysSince(stats?.pushedAt);
        const pushed = pushedLabel(pushedDays);
        return (
          <article data-review-card={entry.id} class="rounded-lg border border-[var(--rr-border)] bg-[var(--rr-surface)] p-4">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0 flex-1">
                <div class="mb-2 flex flex-wrap items-center gap-2">
                  <span data-review-state={entry.id}>
                    <SignalBadge tone={isDraft ? 'warn' : 'core'} label={isDraft ? 'Draft' : 'Published'} />
                  </span>
                  {r.maturity === 'pre-viral' && <SignalBadge tone="core" label="Đáng thử sớm" />}
                  {r.maturity === 'established' && <SignalBadge tone="muted" label="Đã có chỗ đứng" />}
                  {r.vertical.map((v) => (
                    <span class="rounded-full border border-[var(--rr-border)] px-2.5 py-0.5 text-xs text-[var(--rr-muted)]">
                      {industryShort(v)}
                    </span>
                  ))}
                </div>
                <h2 class="text-lg font-semibold">
                  <a href={`/repos/${entry.id}`} class="no-underline hover:text-[var(--rr-core)]">{r.name}</a>
                </h2>
                <p class="mt-1 text-sm text-[var(--rr-muted)]">{r.oneLiner}</p>

                <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--rr-muted)]">
                  {hasScore ? (
                    <span class="rounded-full border border-[var(--rr-core)]/40 bg-[var(--rr-core)]/8 px-2.5 py-0.5 font-bold text-[var(--rr-core)]" title="Signal Score v1">
                      {total}/100
                    </span>
                  ) : (
                    <span class="rounded-full border border-[var(--rr-warn)]/40 bg-[var(--rr-warn)]/8 px-2.5 py-0.5 font-medium text-[var(--rr-warn)]" title="Record chưa có scoreBreakdown">
                      chưa chấm điểm
                    </span>
                  )}

                  {stats?.stars != null && (
                    <span title="Số sao GitHub">⭐ {numberFmt.format(stats.stars)}</span>
                  )}
                  {stats?.starsPerDay != null && (
                    <span title="Sao/ngày — tốc độ tăng trưởng">{stats.starsPerDay.toFixed(1)}/ngày</span>
                  )}
                  {stats?.forks != null && <span title="Forks">⑂ {numberFmt.format(stats.forks)}</span>}

                  {pushed && <span title="Lần push cuối trên GitHub">{pushed}</span>}
                  {r.evidenceLevel && <span title="Evidence Level">Ev.{r.evidenceLevel}</span>}
                  {stats?.archived && <SignalBadge tone="danger" label="Archived" />}
                  {isAbandoned(pushedDays) && !stats?.archived && <SignalBadge tone="warn" label="Có thể đã bỏ" />}

                  <span class="text-[var(--rr-faint)]">{entry.id}.md</span>
                </div>
              </div>

              <div class="flex shrink-0 gap-2">
                <a
                  href={`/repos/${entry.id}`}
                  class="rounded-md border border-[var(--rr-border)] px-3 py-2 text-sm no-underline hover:border-[var(--rr-core)]/50"
                >
                  Đọc
                </a>
                <button
                  type="button"
                  data-slug={entry.id}
                  data-draft={isDraft ? 'false' : 'true'}
                  class:list={[
                    'rounded-md border px-3 py-2 text-sm font-medium',
                    isDraft
                      ? 'border-[var(--rr-core)] bg-[var(--rr-core)] text-white'
                      : 'border-[var(--rr-border)] text-[var(--rr-muted)]',
                  ]}
                >
                  {isDraft ? 'Publish' : 'Về draft'}
                </button>
              </div>
            </div>
          </article>
        );
    })}
  </section>

  <p id="review-status" class="mt-4 text-sm text-[var(--rr-muted)]" aria-live="polite"></p>

  <script define:vars={{ deployOnPublish, isDev: canEdit }}>
    const status = document.querySelector('#review-status');
    // Dev ghi thẳng file qua Vite middleware; prod commit qua GitHub Contents API.
    const endpoint = isDev ? '/__drafts/publish' : '/api/review/publish';

    document.querySelectorAll('button[data-slug]').forEach((button) => {
      button.addEventListener('click', async () => {
        const slug = button.dataset.slug;
        const draft = button.dataset.draft === 'true';
        const liveDeployRequested = deployOnPublish;
        const needsConfirm = liveDeployRequested || !isDev;
        // `draft` là trạng thái ĐÍCH sau thao tác: bấm Publish thì draft = false.
        const confirmationMessage = draft
          ? `Đưa "${slug}" về draft?\n\nThao tác này sẽ gỡ record khỏi live site.`
          : `Publish "${slug}" lên production?\n\nThao tác này sẽ đổi draft:false và cập nhật live site.`;

        if (needsConfirm && !window.confirm(confirmationMessage)) {
          if (status) status.textContent = 'Đã hủy.';
          return;
        }

        button.setAttribute('disabled', 'true');
        if (status) {
          status.textContent = isDev
            ? liveDeployRequested
              ? 'Đang ghi file, build production và deploy...'
              : 'Đang ghi file...'
            : 'Đang commit lên GitHub...';
        }

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              slug,
              draft,
              deploy: liveDeployRequested,
              confirmDeploy: liveDeployRequested,
            }),
          });
          const result = await response.json();
          if (!result.ok) throw new Error(result.error || result.message || 'Không ghi được file');
          button.dataset.draft = draft ? 'false' : 'true';
          button.textContent = draft ? 'Publish' : 'Về draft';
          button.className = draft
            ? 'rounded-md border px-3 py-2 text-sm font-medium border-[var(--rr-core)] bg-[var(--rr-core)] text-white'
            : 'rounded-md border px-3 py-2 text-sm font-medium border-[var(--rr-border)] text-[var(--rr-muted)]';
          const state = document.querySelector(`[data-review-state="${slug}"]`);
          if (state) {
            state.innerHTML = draft
              ? '<span class="rounded-full border border-[var(--rr-warn)]/30 bg-[var(--rr-warn)]/10 px-2 py-0.5 text-xs font-medium text-[var(--rr-warn)]">Draft</span>'
              : '<span class="rounded-full border border-[var(--rr-core)]/30 bg-[var(--rr-core)]/10 px-2 py-0.5 text-xs font-medium text-[var(--rr-core)]">Published</span>';
          }
          button.removeAttribute('disabled');
          if (status) {
            const localMessage = draft ? 'Đã đưa về draft.' : 'Đã publish.';
            if (result.message) status.textContent = result.message;
            else status.textContent = result.deployed ? `${localMessage} Production đã deploy xong.` : localMessage;
          }
        } catch (error) {
          button.removeAttribute('disabled');
          if (status) status.textContent = error instanceof Error ? error.message : 'Có lỗi xảy ra';
        }
      });
    });
  </script>
</BaseLayout>
